{
  "_schema": [
    "goals.json is the single source of truth for the bucket list.",
    "Shape: { \"_schema\": [...], \"goals\": [ goal, ... ] }.",
    "Each goal: { id (unique kebab-case string), title (string),",
    "  category: \"clubs-involvements\" | \"academic\" | \"volunteering\" | \"seasonal\" | \"city\",",
    "  frequency: \"one-time\" | \"ongoing\",",
    "  effort: \"simple\" | \"complex\",",
    "  link (url string or null),",
    "  status: \"not-started\" | \"in-progress\" | \"done\",",
    "  notes (free-text string, may be empty),",
    "  imagePath (relative path to an image under assets/images/, or null),",
    "  mapCoords: { \"x\": 0-1, \"y\": 0-1 } as % of map image, or null (campus goals only) }.",
    "This file holds official progress: edit status/notes/imagePath/mapCoords and commit to update it.",
    "Visitors own copies live in localStorage only and never write back here."
